PORT=3000
NODE_ENV=development
MCP_TITLE="Spotify MCP"
MCP_VERSION=1.1.0
MCP_PROTOCOL_VERSION=2025-11-25
MCP_INSTRUCTIONS="Inspect Spotify data and manage exact playlist items."

AUTH_STRATEGY=oauth
AUTH_ENABLED=true
AUTH_REQUIRE_RS=true
AUTH_ALLOW_DIRECT_BEARER=false
AUTH_RESOURCE_URI=http://127.0.0.1:3000/mcp

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_SCOPES="user-read-private user-read-playback-state user-modify-playback-state user-read-currently-playing user-read-recently-played user-top-read playlist-read-private playlist-read-collaborative playlist-modify-public playlist-modify-private user-library-read user-library-modify"

# The Node authorization server runs on PORT + 1.
OAUTH_REDIRECT_URI=http://127.0.0.1:3001/oauth/callback
OAUTH_REDIRECT_ALLOW_ALL=false
OAUTH_REDIRECT_ALLOWLIST=

RS_TOKENS_FILE=.data/tokens.json
# Required for production. Generate a stable 32-byte base64url secret.
RS_TOKENS_ENC_KEY=
LOG_LEVEL=info
RPS_LIMIT=10
CONCURRENCY_LIMIT=5
