{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotify-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "AUTH_STRATEGY": "oauth",
    "AUTH_ENABLED": "true",
    "AUTH_REQUIRE_RS": "true",
    "AUTH_ALLOW_DIRECT_BEARER": "false",
    "AUTH_RESOURCE_URI": "https://spotify-mcp.YOUR_SUBDOMAIN.workers.dev/mcp",
    "OAUTH_REDIRECT_ALLOW_ALL": "true",
    "SPOTIFY_SCOPES": "user-read-private user-read-playback-state user-modify-playback-state user-read-currently-playing user-read-recently-played user-top-read playlist-read-private playlist-read-collaborative playlist-modify-public playlist-modify-private user-library-read user-library-modify",
    "MCP_TITLE": "Spotify MCP",
    "MCP_VERSION": "1.1.0",
    "MCP_PROTOCOL_VERSION": "2025-11-25",
    "LOG_LEVEL": "info"
  }
}
